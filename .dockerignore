# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docs y tests (no se necesitan para correr la app)
docs/
tests/
*.md
!README.md

# Datos generados (se montan como volumen o se crean en runtime)
data/productos/*
data/resenias/*
!data/productos/.gitkeep
!data/resenias/.gitkeep

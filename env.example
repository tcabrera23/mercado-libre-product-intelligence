# Configuración de API Keys y URLs
# Renombra este archivo a .env para usarlo

# === GROQ API (Opcional) ===
# Obtén tu API key gratis en: https://console.groq.com/
GROQ_API_KEY=tu_api_key_aqui

# === OLLAMA (Opcional) ===
# URL donde está corriendo Ollama
# Por defecto: http://localhost:11434
# En Docker: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
